PORT=4000
NODE_ENV=development
# Supabase pooler URL for the running app (use port 6543 and pgbouncer=true).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase direct connection URL for Prisma migrations (use port 5432).
DIRECT_URL="postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
GOOGLE_MAPS_API_KEY="your-google-maps-key"
DUMMY_USER_ID="user_dummy_001"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret-at-least-32-chars"
# Super admin account created/updated by `npm run prisma:seed`.
# ADMIN_PASSWORD must be at least 6 characters. Never commit the real value.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_PHONE="01104378091"
ADMIN_NAME="Admin"
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_WALLET_INTEGRATION_ID=""
# Phone verification (OTP).
# console = log only (local). whatsapp = Meta WhatsApp Cloud API (production).
SMS_PROVIDER="console"
SMS_SENDER_ID="Zoon"
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# WhatsApp Cloud API (required when SMS_PROVIDER=whatsapp)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE="zoon_otp"
WHATSAPP_OTP_LANGUAGE="ar"
# Use "0" for auth templates with copy-code / URL button; set empty to skip button params.
WHATSAPP_OTP_BUTTON_INDEX="0"
WHATSAPP_GRAPH_VERSION="v21.0"
